# ==========================================
# Copia este archivo como .env y rellena los valores.
# NUNCA subas el .env al repositorio.
# Los valores reales se comparten por un canal privado.
# ==========================================

# Entorno: development | production
APP_ENV=development
APP_PORT=3000

# Base de datos
DB_HOST=localhost
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Seguridad (usar valores largos y aleatorios)
SECRET_KEY=